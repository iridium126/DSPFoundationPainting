#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

struct TileRaw {
    uint index[4];
    ivec2 texPos;
};

layout(std430, binding = 0) buffer PointBuffer { vec2 points[]; };
layout(std430, binding = 1) buffer TileBuffer { TileRaw tiles[]; };
layout(std430, binding = 2) buffer OutputBuffer { uvec2 packed[]; };

layout(std140, binding = 3) uniform UniformBlock {
    uint pointCount;
    uint tileCount;
    float azimuth_angle;
    // 预计算常量（CPU计算后传入，GPU直接读取，零计算开销）
    float polar_sin;         // sin(polar_angle)
    float polar_cos;         // cos(polar_angle)
    float half_paint_sin;    // sin(painting_central_angle * 0.5)
    float half_paint_cos;    // cos(painting_central_angle * 0.5)
} ubo;

const uint FIXED_SCALE = 0x7FFFFu;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= ubo.tileCount) return;

    TileRaw tile = tiles[gid];
    vec2 p0 = points[tile.index[0]];
    vec2 p1 = points[tile.index[1]];
    vec2 p2 = points[tile.index[2]];
    vec2 p3 = points[tile.index[3]];

    vec2 uv_max = max(max(max(p0, p1), p2), p3);
    vec2 uv_min = min(min(min(p0, p1), p2), p3);
    vec2 uv = (uv_max + uv_min) * 0.5;

    uvec2 uv_fixed = uvec2(uv * FIXED_SCALE);

    packed[gid] = uvec2(
        (uv_fixed.y << 13) | (tile.texPos.y & 0x1FFF),
        (uv_fixed.x << 13) | (tile.texPos.x & 0x1FFF)
    );
}